# Copy to .env and fill in. Placeholders only: never commit real values.

# Database (Supabase Postgres: pooled URL for the app, direct URL for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_SEED_PASSWORD="choose-a-strong-password-for-the-first-admin"

# Product image storage (Supabase Storage, public bucket "product-images")
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Public links shown on the storefront
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/62xxxxxxxxxx"
NEXT_PUBLIC_SHOPEE_URL="https://shopee.co.id/search?keyword=your-store"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/your-store"

# Password reset e-mail (Resend). With the testing sender below, Resend only
# delivers to the e-mail that owns the Resend account.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Midtrans Snap. Leave keys empty to fall back to the manual QRIS + WhatsApp flow.
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
